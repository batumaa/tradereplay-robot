{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tradereplay-robot",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-23",
  // Public values only. The robot's token is made at pairing and kept in its Durable Object.
  "vars": {
    "ENGINE_URL": "https://tradereplay-engine-829746244216.us-central1.run.app",
    "SITE_ORIGINS": "https://new.tradereplay.co,https://tradereplay.co,https://www.tradereplay.co"
  },
  "durable_objects": { "bindings": [{ "name": "ROBOT", "class_name": "RobotDO" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RobotDO"] }]
}
